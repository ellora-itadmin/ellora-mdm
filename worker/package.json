{
  "name": "ellora-mdm-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply ellora-mdm-db --local",
    "migrate:remote": "wrangler d1 migrations apply ellora-mdm-db --remote",
    "seed:remote": "wrangler d1 execute ellora-mdm-db --remote --file=./seed.sql",
    "seed:local": "wrangler d1 execute ellora-mdm-db --local --file=./seed.sql"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "hono": "^4.6.9",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
